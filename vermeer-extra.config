# vermeer 额外内核配置片段
#
# 与树内 arch/arm64/configs/{sm8550,hardening}.config 一起叠加在 defconfig 之上，
# 顺序：defconfig → sm8550.config → hardening.config → 本文件（后者覆盖前者）。
#
# 依据（XEC 树的实测差异）：sm8550.config 里 modem / IPA / rmnet 这一串仍是 =m，
# 而 K70 走的是「没有任何 initramfs、rootfs 直接在分区上」的启动方式（与 sheng 相同），
# =m 的驱动在首启阶段根本不会被加载 → 表现为「内核起来了但 modem/IPA 完全不存在」。
# 把这条链路提为 =y 是让 `mmcli -L` 在首启就能看到 modem 的前提。
#
# 注意：这一组只解决「驱动存在」，不等于 4G 已通。设备树里 &ipa 节点还没启用，
# 详见 docs/移植对照.md 的「阶段三」。

CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_IPA=y
CONFIG_RMNET=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_MHI=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_FASTRPC=y
CONFIG_QCOM_BAM_DMUX=y

# WiFi/BT：WCN7850 走 ath12k（固件随 firmware-xiaomi-vermeer 一起装）
CONFIG_ATH12K=y
CONFIG_ATH12K_AHB=m
CONFIG_BT_QCA=m
